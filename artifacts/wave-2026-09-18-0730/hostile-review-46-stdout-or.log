const puppeteer = require('puppeteer-core');
const fs = require('fs');
const path = require('path');

const SCRIPT = fs.readFileSync(path.join(__dirname, '..', 'rapid-feedback.user.js'), 'utf8');
const BROWSER = process.env.RAPID_FEEDBACK_BROWSER || 'chrome';
const EXECUTABLE = process.env.RAPID_FEEDBACK_EXECUTABLE || process.env.RAPID_FEEDBACK_CHROME || (BROWSER === 'firefox'
	? '/Applications/Firefox.app/Contents/MacOS/firefox'
	: '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome');
const POP = `(() => { for (const h of [...document.body.children, ...document.documentElement.children]) { const p = h.shadowRoot?.querySelector('.rf-popover'); if (p) return p; } return null; })()`;
// Selection markers live in a shadow root, so count them across all chrome roots.
const MARKERS = `(() => { let n = 0; for (const h of [...document.body.children, ...document.documentElement.children]) n += h.shadowRoot?.querySelectorAll('.rf-marker').length || 0; return n; })()`;

function createReporter() {
	const results = [];
	return {
		check(name, cond, detail) {
			results.push({ name, ok: !!cond, detail });
			console.log((cond ? 'PASS  ' : 'FAIL  ') + name + (detail && !cond ? '\n      ' + detail : ''));
		},
		finish() {
			const fails = results.filter(r => !r.ok);
			console.log('\n' + (results.length - fails.length) + '/' + results.length + ' checks passed');
			return fails.length === 0;
		}
	};
}

async function withPage(run) {
	const browser = await puppeteer.launch({ browser: BROWSER, executablePath: EXECUTABLE, headless: true, args: BROWSER === 'firefox' ? ['-no-remote'] : ['--no-sandbox'] });
	try {
		const page = await browser.newPage();
		await page.setViewport({ width: 1200, height: 800 });
		page.on('pageerror', e => console.log('PAGEERROR: ' + e.message));
		page.on('console', m => { if (m.type() === 'error') console.log('CONSOLE ERR: ' + m.text()); });
		// The userscript closes its shadow roots so host pages can't reach into the
		// feedback UI. Tests introspect that UI, so force roots open in the harness.
		// Runs in every document (including navigations) before page scripts.
		await page.evaluateOnNewDocument(() => {
			const original = Element.prototype.attachShadow;
			Element.prototype.attachShadow = function (init) {
				return original.call(this, { ...init, mode: 'open' });
			};
		});
		await page.goto('file://' + path.join(__dirname, 'page.html'));
		await page.evaluate(SCRIPT);
		const chordClick = async (sel) => {
			const box = await page.$eval(sel, el => { const r = el.getBoundingClientRect(); return { x: r.x + r.width / 2, y: r.y + r.height / 2 }; });
			await page.mouse.click(box.x, box.y);
		};
		return await run(page, chordClick);
	} finally {
		await browser.close();
	}
}

// Bounded polling replaces guessed sleeps: evaluate `pageExpr` in the page
// until truthy. A timeout throws with the description and last value so a
// stall diagnoses itself instead of silently passing after a fixed nap.
const delay = (ms) => new Promise(r => setTimeout(r, ms));
async function waitFor(page, pageExpr, { timeoutMs = 2000, intervalMs = 25, description } = {}) {
	const deadline = Date.now() + timeoutMs;
	let last;
	while (Date.now() < deadline) {
		last = await page.evaluate(`(() => ${pageExpr})()`);
		if (last) return last;
		await delay(intervalMs);
	}
	throw new Error('waitFor timeout after ' + timeoutMs + 'ms: ' + (description || pageExpr.slice(0, 80)) + ' (last=' + JSON.stringify(last) + ')');
}
const waitForPopover = (page, opts) => waitFor(page, `!!(${POP})`, { description: 'popover open', ...opts });
const waitForPopoverGone = (page, opts) => waitFor(page, `!(${POP})`, { description: 'popover closed', ...opts });

module.exports = { POP, MARKERS, createReporter, withPage, waitFor, waitForPopover, waitForPopoverGone };
