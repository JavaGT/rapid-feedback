    54	// Bounded polling replaces guessed sleeps: evaluate `pageExpr` in the page
    55	// until truthy. A timeout throws with the description and last value so a
    56	// stall diagnoses itself instead of silently passing after a fixed nap.
    57	const delay = (ms) => new Promise(r => setTimeout(r, ms));
    58	async function waitFor(page, pageExpr, { timeoutMs = 2000, intervalMs = 25, description } = {}) {
    59		const deadline = Date.now() + timeoutMs;
    60		let last;
    61		while (Date.now() < deadline) {
