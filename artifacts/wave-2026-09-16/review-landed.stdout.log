    32			page.on('console', m => { if (m.type() === 'error') console.log('CONSOLE ERR: ' + m.text()); });
    33			// The userscript closes its shadow roots so host pages can't reach into the
    34			// feedback UI. Tests introspect that UI, so force roots open in the harness.
    35			// Runs in every document (including navigations) before page scripts.
    36			await page.evaluateOnNewDocument(() => {
    37				const original = Element.prototype.attachShadow;
    38				Element.prototype.attachShadow = function (init) {
    39					return original.call(this, { ...init, mode: 'open' });
    40				};
